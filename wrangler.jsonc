{
  "name": "wi-training-center",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "./static", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "wi-training-center-db" }],
  "r2_buckets": [{ "binding": "PDFS" }]
}
