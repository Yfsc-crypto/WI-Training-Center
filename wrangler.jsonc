{
  "name": "wi-training-center",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wi-training-center-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDFS",
      "bucket_name": "wi-training-center-pdfs"
    }
  ],
  "build": {
    "command": "if [ \"$CI\" = \"true\" ]; then bucket=wi-training-center-pdfs; wrangler r2 bucket info \"$bucket\" || wrangler r2 bucket create \"$bucket\" || wrangler r2 bucket info \"$bucket\"; fi"
  }
}
